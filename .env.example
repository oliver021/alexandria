# Secret used to sign login JWTs. Set a long random value outside development.
JWT_SECRET=dev-secret-do-not-use-in-production

# Database connection URL. When unset, the SQLite file from config.yml is used.
DATABASE_URL=sqlite+aiosqlite:///data/alexandria.db

# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOGGING_LEVEL=INFO

# Runtime environment: development or production. Defaults to production when unset.
ALEXANDRIA_ENV=development

# Public base URL of this server, used to build absolute links such as download URLs.
# PUBLIC_URL=http://localhost:8000

# Directory where uploaded package archives are stored. Relative paths resolve from the project root.
# STORAGE_PATH=data/blobs

# Allow anonymous reads of published entries (true) or require a credential for every read (false).
# PUBLIC_READ=true

# Publish uploaded versions immediately (true) instead of leaving them as drafts (false).
# AUTO_PUBLISH=false

# Comma-separated list of allowed CORS origins. Replaces the list from config.yml.
# CORS_ORIGINS=http://localhost:8000,http://localhost:5173
